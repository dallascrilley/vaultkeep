{
  "name": "op-cli-helper",
  "version": "1.0.0",
  "description": "Easy secret retrieval from 1Password with smart fallbacks",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ops": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
