{
  "name": "dc-ops-cli",
  "version": "1.12.1",
  "description": "Easy secret retrieval from 1Password with smart fallbacks",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ops": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dallascrilley/op-cli-helper.git"
  },
  "scripts": {
    "build:bin": "bun build --compile src/index.ts --outfile bin/ops",
    "build": "tsc",
    "dev": "TS_NODE_TRANSPILE_ONLY=1 node --import ./scripts/register-ts-node.mjs src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "TS_NODE_TRANSPILE_ONLY=1 node --test --import ./scripts/register-ts-node.mjs tests/commands/*.test.ts tests/utils/*.test.ts",
    "test:unit": "TS_NODE_TRANSPILE_ONLY=1 node --test --import ./scripts/register-ts-node.mjs tests/commands/*.test.ts tests/utils/*.test.ts",
    "test:integration": "npm run build && TEST_OP_CLI=1 TS_NODE_TRANSPILE_ONLY=1 node --test --import ./scripts/register-ts-node.mjs tests/integration/*.test.ts",
    "test:all": "npm run test:unit && npm run test:integration",
    "prepublishOnly": "npm run build",
    "release": "semantic-release --dry-run",
    "release:ci": "semantic-release"
  },
  "keywords": [
    "1password",
    "secrets",
    "cli",
    "security"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.17.1",
    "chalk": "^5.3.0",
    "clipboardy": "^3.0.0",
    "commander": "^11.1.0",
    "cross-spawn": "^7.0.3",
    "dotenv": "^16.4.5",
    "inquirer": "^9.2.12",
    "inquirer-autocomplete-prompt": "^3.0.1",
    "ora": "^7.0.1",
    "yaml": "^2.8.2"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@types/cross-spawn": "^6.0.2",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.10.6",
    "@types/picomatch": "^4.0.2",
    "semantic-release": "^25.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
