{
  "name": "op-cli-helper",
  "version": "1.0.0",
  "description": "Easy secret retrieval from 1Password with smart fallbacks",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "ops": "./dist/index.js"
  },
  "scripts": {
    "build:bundle": "esbuild src/index.ts --bundle --platform=node --target=node18 --format=cjs --outfile=dist/ops.cjs",
    "build:bin": "npm run build:bundle && pkg dist/ops.cjs --targets node18-macos-arm64 --output bin/ops",
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "node --test",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "1password",
    "secrets",
    "cli",
    "security"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^11.1.0",
    "inquirer": "^9.2.12",
    "ora": "^7.0.1"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.10.6",
    "esbuild": "^0.27.2",
    "pkg": "^5.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
